<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>margin — the desk</title>
{{template "themehead" .}}
<link rel="stylesheet" href="/static/design-system.css">
</head>
<body>
<a class="skip" href="#mg-desk">Skip to content</a>
<header class="site-header">
  <a class="doc-name" href="/">margin</a>
  <span class="crumb">the desk</span>
  <span class="spacer"></span>
  {{template "themetoggle" .}}
</header>
<main class="index" id="mg-desk" tabindex="-1">
  <h1 class="doc-title">The desk</h1>
  <p class="lead">Documents awaiting review. Select one to read — your margin notes travel with the words.</p>
  {{if .Empty}}
  <div class="empty">
    <div class="empty-mark">❧</div>
    <p class="empty-head">The desk is clear.</p>
    <p>Drop a Markdown file in <code>docs/</code> and reload to begin a review.</p>
  </div>
  {{else}}
  <div class="doc-tree">{{template "doctree" .Tree}}</div>
  {{end}}
</main>
<script>
/* remember which folders are collapsed (per data-dir key) across visits */
(function () {
  var dirs = document.querySelectorAll("details.dir[data-dir]");
  dirs.forEach(function (d) {
    var key = "mg-dir:" + d.getAttribute("data-dir");
    try { if (localStorage.getItem(key) === "0") d.open = false; } catch (e) {}
    d.addEventListener("toggle", function () {
      try { localStorage.setItem(key, d.open ? "1" : "0"); } catch (e) {}
    });
  });
})();
</script>
</body>
</html>
