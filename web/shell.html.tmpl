<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}} · margin</title>
{{template "themehead" .}}
<link rel="stylesheet" href="/static/design-system.css">
</head>
<body data-slug="{{.Slug}}">
<a class="skip" href="#mg-article">Skip to content</a>
<div id="progress" aria-hidden="true"></div>
<header class="site-header">
  <a class="doc-name" href="/">margin</a>
  <span class="crumb">{{.Title}}</span>
  <span class="spacer"></span>
  {{template "themetoggle" .}}
  <button class="h-btn" id="mg-toggle" type="button" aria-label="Toggle comments" aria-expanded="false" aria-controls="mg-sidebar" title="Comments — toggle sidebar">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="15" height="15"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
    Comments <span class="pill" id="mg-open-count" hidden>0</span>
  </button>
</header>
<div class="layout">
  <nav class="toc" aria-label="Table of contents">
    {{range .TOC}}<a class="lvl-{{.Level}}" href="#{{.ID}}">{{.Text}}</a>{{end}}
  </nav>
  <article id="mg-article" role="main" tabindex="-1">
    <h1 class="doc-title">{{.Title}}</h1>
    <div class="dateline">{{with .Status}}<span class="status">{{.}}</span>{{end}}{{with .Date}}<time>{{.}}</time>{{end}}{{if .ReadMins}}<span class="read">{{.ReadMins}} min read</span><span class="words">{{.WordsHuman}} words</span>{{end}}</div>
    {{with .Lead}}<p class="lead">{{.}}</p>{{end}}
    <div class="prose">{{.Body}}</div>
  </article>
</div>
<script>
/* doc chrome — reading progress + active TOC. The only non-widget JS. No deps. */
(function () {
  "use strict";
  var bar = document.getElementById("progress");
  var links = [].slice.call(document.querySelectorAll(".toc a"));
  var map = new Map(links.map(function (a) { return [a.getAttribute("href").slice(1), a]; }));
  var toc = document.querySelector(".toc");
  var heads = [].slice.call(document.querySelectorAll("article h2[id], article h3[id]"));
  var headerH = parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--header-h")) || 60;
  var current = null;

  function setActive(a) {
    if (a === current) return;
    if (current) { current.classList.remove("active"); current.removeAttribute("aria-current"); }
    current = a;
    if (a) {
      a.classList.add("active");
      a.setAttribute("aria-current", "location");
      // keep the active entry in view ONLY when the TOC itself overflows — scoped to
      // the TOC's own scroll so it can never nudge the window (no feedback loop)
      if (toc && toc.scrollHeight > toc.clientHeight) {
        var rt = a.getBoundingClientRect(), rc = toc.getBoundingClientRect();
        if (rt.top < rc.top) toc.scrollTop -= rc.top - rt.top + 8;
        else if (rt.bottom > rc.bottom) toc.scrollTop += rt.bottom - rc.bottom + 8;
      }
    }
  }

  // Position-based scrollspy: the active section is the last heading whose top has
  // crossed a "reading line" just below the sticky header — so it stays in sync
  // mid-section, not only when the next heading reaches the top.
  function spy() {
    var de = document.documentElement;
    var max = de.scrollHeight - de.clientHeight;
    bar.style.width = (max > 0 ? (de.scrollTop / max) * 100 : 0) + "%";
    if (!heads.length) return;

    // at the very bottom, the final section is active even if its heading never
    // reaches the reading line (short last section)
    if (max > 0 && max - de.scrollTop < 2) { setActive(map.get(heads[heads.length - 1].id) || null); return; }

    var line = headerH + 24;
    var active = null;
    for (var i = 0; i < heads.length; i++) {
      if (heads[i].getBoundingClientRect().top <= line) active = map.get(heads[i].id) || active;
      else break;
    }
    // before the first heading, highlight nothing rather than mis-pointing
    setActive(active);
  }

  var ticking = false;
  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(function () { spy(); ticking = false; });
  }
  document.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", onScroll, { passive: true });
  spy();
  // hover ¶ anchor link on each section heading
  document.querySelectorAll("article h2[id], article h3[id]").forEach(function (h) {
    var a = document.createElement("a");
    a.className = "h-anchor";
    a.href = "#" + h.id;
    a.textContent = "¶";
    // name the link by its section so screen-reader users can tell anchors apart;
    // tabindex=-1 keeps these decorative links out of the Tab order
    a.setAttribute("aria-label", "Link to section: " + (h.textContent || "").trim());
    a.tabIndex = -1;
    // click copies the section permalink (and still navigates) — a quiet delight
    a.addEventListener("click", function () {
      if (navigator.clipboard) {
        try { navigator.clipboard.writeText(location.origin + location.pathname + "#" + h.id); } catch (e) {}
      }
      if (window.__mgToast) window.__mgToast("Section link copied");
    });
    h.appendChild(a);
  });
  // copy-to-clipboard button on each code block (revealed on hover/focus)
  if (navigator.clipboard) {
    document.querySelectorAll("article pre").forEach(function (pre) {
      var btn = document.createElement("button");
      btn.className = "code-copy";
      btn.type = "button";
      btn.textContent = "Copy";
      btn.setAttribute("aria-label", "Copy code to clipboard");
      btn.addEventListener("click", function () {
        var code = pre.querySelector("code");
        navigator.clipboard.writeText((code || pre).innerText).then(function () {
          btn.textContent = "Copied"; btn.classList.add("ok");
          setTimeout(function () { btn.textContent = "Copy"; btn.classList.remove("ok"); }, 1600);
        });
      });
      pre.appendChild(btn);
    });
  }
})();
</script>
<div id="mg-toasts" aria-live="polite" aria-atomic="false"></div>
<script src="/static/widget.js" defer></script>
</body>
</html>
